{
  "name": "mingdyn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "data": "python3 scripts/build_data.py",
    "predev": "npm run data",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run data && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:data": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "test:e2e": "playwright test",
    "check": "npm run test:data && npm run build && npm run test:e2e",
    "format": "prettier --write src tests/*.ts *.ts *.json *.html .github/workflows/*.yml data/*.json README.md"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "3.9.9",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
